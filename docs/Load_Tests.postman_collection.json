{
    "name": "FaceDeep API v2 Load Test",
    "config": {
        "env": {
            "BASE_URL": "http://localhost:8000"
        }
    },
    "item": [
        {
            "name": "Health Check - No Auth",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status is 200', function() { pm.response.to.have.status(200); });",
                            "pm.test('Response time < 200ms', function() { pm.expect(pm.response.responseTime).to.be.below(200); });"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "url": "{{BASE_URL}}/api/v2/health"
            }
        },
        {
            "name": "Recognize Face - With API Key",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status is 200 or 404', function() { pm.expect(pm.response.code).to.be.oneOf([200, 404]); });",
                            "pm.test('Response time < 3s', function() { pm.expect(pm.response.responseTime).to.be.below(3000); });"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "url": "{{BASE_URL}}/api/v2/face/recognize",
                "header": [
                    { "key": "X-API-Key", "value": "{{apiKey}}" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\"image\": \"data:image/jpeg;base64,/9j/4AAQSkZJRg==\"}"
                }
            }
        },
        {
            "name": "Rate Limit Test",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Rate limit returns 429', function() { if(pm.iterationData.get('iteration') > 10) { pm.response.to.have.status(429); } });"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "url": "{{BASE_URL}}/api/v2/face/all",
                "header": [
                    { "key": "X-API-Key", "value": "fd_test_rate_limit_key" }
                ]
            }
        }
    ]
}
