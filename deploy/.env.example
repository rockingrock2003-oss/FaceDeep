# ===========================================
# FaceDeep Production Environment
# Copy this to .env and fill in values
# ===========================================

# Environment
ENVIRONMENT=production

# Database
POSTGRES_USER=facedeep
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
POSTGRES_DB=facedeep
DATABASE_URL=postgresql+asyncpg://facedeep:CHANGE_THIS_TO_STRONG_PASSWORD@postgres:5432/facedeep

# ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=/app/chroma_data

# Face Recognition
ARCFACE_MODEL_PATH=buffalo_l
ARCFACE_DET_SIZE=640
FACE_RECOGNITION_THRESHOLD=0.4

# Liveness
LIVENESS_EAR_THRESHOLD=0.21
LIVENESS_CONSEC_FRAMES=3
LIVENESS_MIN_SCORE=70.0

# Security - GENERATE: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS - your domain
CORS_ORIGINS=["https://facedeep.me"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# SMTP Email (Namecheap or your provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=FaceDeep
BASE_URL=https://facedeep.me

# Stripe (get from dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Payment Links (create in Stripe Dashboard → Payment Links)
# Each link should redirect to: https://facedeep.me/api/v1/billing/activate?plan=PLAN_NAME
STRIPE_PAYMENT_LINK_STARTER=https://buy.stripe.com/xxx
STRIPE_PAYMENT_LINK_PRO=https://buy.stripe.com/xxx
STRIPE_PAYMENT_LINK_ENTERPRISE=https://buy.stripe.com/xxx

# Plan Limits
FREE_DAILY_LIMIT=100
STARTER_DAILY_LIMIT=10000
PRO_DAILY_LIMIT=100000
ENTERPRISE_DAILY_LIMIT=-1
