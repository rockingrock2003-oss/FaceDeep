# --- Required in production -------------------------------------------------
# Access keys the attendance app signs requests with (same as AWS IAM keys).
# Comma separated KEY_ID:SECRET pairs. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(30))"
FACEGATE_CREDENTIALS=AKIAATTENDANCEAPP01:replace-with-a-long-random-secret
# 32-byte key (base64) that encrypts face templates at rest. Keep it in your
# secret manager; losing it means re-enrolling everyone.
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
FACEGATE_DATA_KEY=
# Bearer token for /admin endpoints (look-alike report, audit log, re-index).
FACEGATE_ADMIN_TOKEN=

# API key(s) for the REST liveness API (/v1/liveness), sent as x-api-key.
# Comma separated; leave empty to disable that API.
#   python -c "import secrets; print('lk_' + secrets.token_urlsafe(32))"
FACEGATE_API_KEYS=
# Public https address of this server, used in captureUrl/resultUrl.
# FACEGATE_PUBLIC_BASE_URL=https://liveness.example.com

# --- Behaviour (defaults shown) ---------------------------------------------
# FACEGATE_PASSIVE_LIVENESS_ON_SEARCH=enforce   # off | report | enforce
# FACEGATE_PASSIVE_LIVENESS_THRESHOLD=0.5
# FACEGATE_AMBIGUITY_POLICY=reject              # reject | report
# FACEGATE_AMBIGUITY_MARGIN=0.08
# FACEGATE_LOOKALIKE_THRESHOLD=0.55
# FACEGATE_AWS_REGION=us-east-1                 # echoed in ARNs only
# FACEGATE_LIVENESS_PASS_CONFIDENCE=70
# FACEGATE_LIVENESS_SESSION_RETENTION_SECONDS=3600
# FACEGATE_AUDIT_RETENTION_DAYS=90
