# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://facedeep:facedeep_secret@localhost:5432/facedeep
DATABASE_URL_SYNC=postgresql://facedeep:facedeep_secret@localhost:5432/facedeep
POSTGRES_USER=facedeep
POSTGRES_PASSWORD=facedeep_secret
POSTGRES_DB=facedeep

# Redis
REDIS_URL=redis://localhost:6379/0

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./chroma_data

# ArcFace Model
ARCFACE_MODEL_PATH=buffalo_l
ARCFACE_MODEL_ROOT=~/.insightface
ARCFACE_DET_SIZE=640
FACE_RECOGNITION_THRESHOLD=0.4

# Liveness Detection
LIVENESS_EAR_THRESHOLD=0.21
LIVENESS_CONSEC_FRAMES=3
LIVENESS_MIN_SCORE=70
# Optional request-signing secret for server-to-server clients. Leave blank for the web UI.
LIVENESS_HMAC_SECRET=

# Security
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Email (SMTP). Leave credentials blank in development to auto-verify local accounts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=FaceDeep
BASE_URL=http://localhost:8000

# App
ENVIRONMENT=development
SEED_TEST_USER=false
API_V1_PREFIX=/api/v1
API_V2_PREFIX=/api/v2

# Stripe (optional; configure these together for paid plans)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_LINK_STARTER=
STRIPE_PAYMENT_LINK_PRO=
STRIPE_PAYMENT_LINK_ENTERPRISE=

# Sentry (get from https://sentry.io)
SENTRY_DSN=

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000

# OAuth - Apple
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/apple/callback
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# SSO
SSO_OKTA_CLIENT_ID=
SSO_OKTA_CLIENT_SECRET=
SSO_OKTA_ISSUER=https://your-domain.okta.com/oauth2/default
SSO_AZURE_CLIENT_ID=
SSO_AZURE_CLIENT_SECRET=
SSO_AZURE_TENANT_ID=
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=

# Cloudflare (optional)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
